{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/python -m app.main doctor)",
      "Bash(.venv/bin/python -m app.main memory)",
      "Bash(.venv/bin/python -m app.main plan:*)",
      "Bash(python -m compileall:*)",
      "mcp__github-scout__search_repositories",
      "mcp__github-scout__list_releases",
      "mcp__github-scout__get_readme",
      "Bash(.venv/bin/python -m app.main report:*)",
      "Bash(.venv/bin/python -m app.main instructions:*)",
      "mcp__notion-veille__search_pages",
      "mcp__notion__API-post-search",
      "mcp__notion__API-retrieve-a-page",
      "mcp__claude_ai_Claude_Docs__batch",
      "mcp__claude_ai_Claude_Docs__guide",
      "mcp__claude_ai_Claude_Docs__update",
      "Bash(curl -s -m 10 -H 'accept: application/dns-json' 'https://cloudflare-dns.com/dns-query?name=ubuntu.tail7d8b26.ts.net&type=A')",
      "Skill(schedule)",
      "Skill(schedule:*)",
      "Bash(python -m compileall -q app)",
      "Bash(.venv/bin/python -m pytest -q)",
      "Bash(./node_modules/.bin/bun test *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)"
    ]
  },
  "enabledMcpjsonServers": [
    "github-scout",
    "notion-veille",
    "notion"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_context.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_edit.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_tests.sh"
          }
        ]
      }
    ]
  }
}