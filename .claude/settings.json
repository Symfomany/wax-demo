{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/python -m app.main doctor)",
      "Bash(.venv/bin/python -m app.main memory)",
      "Bash(.venv/bin/python -m app.main plan:*)",
      "Bash(python -m compileall:*)",
      "mcp__github-scout__search_repositories",
      "mcp__github-scout__list_releases",
      "mcp__github-scout__get_readme",
      "Bash(.venv/bin/python -m app.main report:*)",
      "Bash(.venv/bin/python -m app.main instructions:*)",
      "mcp__notion-veille__search_pages",
      "mcp__notion__API-post-search",
      "mcp__notion__API-retrieve-a-page",
      "Bash(.venv/bin/python -m pytest -q tests/e2e/test_web_e2e.py::test_only_one_run_at_a_time tests/test_cli_commands.py::test_review_command_fetches_a_real_page_and_prints_a_sourced_review)",
      "Bash(.venv/bin/pip show *)",
      "Read(//run/systemd/shutdown/**)",
      "Bash(busctl get-property *)",
      "Bash(crontab -l)",
      "Bash(sudo -n crontab -l)",
      "Read(//var/spool/cron/**)",
      "Bash(atq)",
      "Bash(systemctl list-timers *)",
      "Read(//home/boyer/.config/**)",
      "Read(//home/boyer/**)",
      "Bash(grep -E 'shutdown|poweroff|sleep [0-9]{3,}')",
      "Bash(ollama stop *)",
      "Bash(ollama ps *)",
      "Bash(curl -s http://127.0.0.1:11434/api/generate -d '{\"model\":\"ministral-3:3b\",\"prompt\":\"Réponds OK\",\"stream\":false,\"keep_alive\":\"30m\",\"options\":{\"num_ctx\":4096}}')",
      "Bash(python3 -c 'import sys,json;d=json.load\\(sys.stdin\\);print\\(\"réponse:\",d.get\\(\"response\",\"\"\\).strip\\(\\)[:60],\"| load\",round\\(d[\"load_duration\"]/1e9,1\\),\"s | eval\",round\\(d[\"eval_count\"]/\\(d[\"eval_duration\"]/1e9\\),1\\),\"tok/s\"\\)')",
      "Bash(journalctl -u ollama --since \"-2min\" --no-pager)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)"
    ]
  },
  "enabledMcpjsonServers": [
    "github-scout",
    "notion-veille",
    "notion"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_context.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_edit.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_tests.sh"
          }
        ]
      }
    ]
  }
}
