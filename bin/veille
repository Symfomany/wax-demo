#!/usr/bin/env bash
# veille — lanceur CLI de LLM Watch Harness.
#
#   bin/veille cycle -k MCP -k agents     # run → digest → décision interactive → resume
#   bin/veille run [options de run]       # python -m app.main run …
#   bin/veille resume <run_id> --approved --note "…"
#   bin/veille approve <run_id> ["note"]  # raccourci : resume --approved
#   bin/veille reject <run_id> "motif"    # raccourci : resume --rejected
#   bin/veille start | stop | restart | status | logs   # serveur web en arrière-plan
#
# Variables : VEILLE_PYTHON (défaut .venv/bin/python), VEILLE_RUN_DIR (défaut data/ : web.pid, web.log),
# VEILLE_HOST / VEILLE_PORT (défaut 127.0.0.1:8000), LLM_MODEL, LLM_PROVIDER… (priment sur .env).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${VEILLE_PYTHON:-$ROOT/.venv/bin/python}"
RUN_DIR="${VEILLE_RUN_DIR:-$ROOT/data}"
PID_FILE="$RUN_DIR/web.pid"
URL_FILE="$RUN_DIR/web.url"
LOG_FILE="$RUN_DIR/web.log"
export COLUMNS="${COLUMNS:-160}"   # sortie Rich lisible (lignes non coupées)

usage() {
  cat <<'EOF'
Usage : veille <commande> [arguments]

Veille
  cycle [options run]          Lance une veille, affiche le digest, demande publier/rejeter, reprend le run
  run [options run]            python -m app.main run (options : --no-collect --no-mcp --approve
                               -k MOT -s SOURCE --max-age N --max-docs N --match-all)
  resume <run_id> --approved|--rejected [--note "…"]
  approve <run_id> ["note"]    Publie un run en attente (note facultative, mémorisée)
  reject <run_id> "motif"      Rejette un run en attente ; le motif devient une leçon
  pending                      Liste les runs en attente de validation
  show <run_id>                Affiche le digest d'un run en attente

Profil, review et connaissances
  grill                        Entretien Grill-me : cerner ce que tu cherches en actu IA
  review <url> [--json]        Review sourcée d'une actualité (scraping, règles métiers, citations vérifiées)
  knowledge [terme] [--index]  Base de connaissances (glossaire, règles métiers) ; --add fichier.md pour l'enrichir
  source add <url> | list | remove <type> <valeur>
  news crawl | search ["sujets"] [--days N] | list [-s SOURCE]
                               Actus en cartes : claude.com/blog, OpenAI News, recherche web Claude (CLAUDE_API)
                               Sources de la veille : ajout par URL (blog, flux, dépôt GitHub, arXiv) vérifié
  news screenshots             Aperçus des actus sans image (serveur MCP Playwright, SCREENSHOT_ENABLED)
  events search ["sujets"] | crawl | list
                               Événements IA (web search Claude, dates vérifiées dans la page ; flux .ics)
  media search ["sujets"] | crawl | list
  benchmarks crawl | list [texte] | show <clé>
                               Benchmarks LLM de BenchLM.ai : catalogue, classement, fiabilité des scores
                               Vidéos, podcasts et émissions IA (web search Claude ; flux [[media]])

Serveur web
  start [--port N] [--host H]  Démarre l'interface web en arrière-plan (défaut http://127.0.0.1:8000)
  stop                         Arrête le serveur démarré par « start »
  restart [--port N]           Redémarre (même hôte et port par défaut), ex. après une modif du code ou de .env
  status                       État du serveur : PID, URL, santé (LLM, Notion)
  logs [-f]                    Journal du serveur (data/web.log) ; -f pour le suivre
  web [--port N]               Interface web au premier plan (Ctrl+C pour arrêter)
  web-password [--write-env]   Génère un mot de passe conforme ; --write-env l'ajoute à .env (login web)
  tui [écran]                  Interface terminal (OpenTUI) ; démarre le serveur au besoin
                               écrans : home chat search review watch knowledge sources reports memory grill
  tui-build [cible]            Compile la TUI en exécutable autonome tui/dist/veille-tui (cible : bun-linux-arm64
                               pour la Jetson) ; ensuite : tui/dist/veille-tui [écran], sans Bun ni node_modules

Cron quotidien (APScheduler, 7 h par défaut : CRON_HOUR, CRON_MINUTE, CRON_TASKS…)
  cron start                   Démon au premier plan (service : systemd/veille-cron.service)
  cron once [-t TÂCHE] [--force]
                               Un cycle maintenant : benchmarks, actus (crawl + web), événements (ics + web)
  cron status                  Prochain passage, dernier succès de chaque tâche (journal : data/cron.log)

Outils
  doctor                       Diagnostic (Ollama, modèle, GPU, MCP, migrations)
  report                       Régénère le rapport daté (Markdown + HTML) de la dernière veille
  notion                       Publie la page Notion des 10 dernières veilles
  memory                       Mémoire de veille (leçons, centres d'intérêt, sources)
  why [--json]                 Pourquoi cette veille ? (profil d'impact, mémoire typée, règles)
  rules [--accept|--dismiss K] Règles suggérées après des rejets récurrents
  test                         Lance les tests (pytest -q)

Exemple : LLM_MODEL=gemma-3-4b-it veille cycle -k quantization --max-age 7
EOF
}

die() { echo "veille : $*" >&2; exit 2; }

app() { cd "$ROOT" && "$PYTHON" -m app.main "$@"; }

require_python() {
  [[ -x "$PYTHON" ]] || die "interpréteur introuvable : $PYTHON (créer le venv : python3 -m venv .venv && .venv/bin/pip install -e '.[dev]')"
}

# --- Serveur web en arrière-plan ------------------------------------------------------

# PID du serveur s'il tourne (et s'il s'agit bien de notre serveur), sinon rien.
server_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE")"
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && ps -ww -p "$pid" -o args= | grep -q "app.main web"; then
    echo "$pid"
    return 0
  fi
  rm -f -- "$PID_FILE" "$URL_FILE"   # PID périmé (serveur arrêté ou machine redémarrée)
  return 1
}

healthy() { curl -fsS --max-time 2 "$1/api/health" >/dev/null 2>&1; }

start_server() {
  local host="${VEILLE_HOST:-127.0.0.1}" port="${VEILLE_PORT:-8000}" pid url
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) [[ $# -ge 2 ]] || die "usage : veille start [--port N] [--host H]"; port="$2"; shift 2 ;;
      --host) [[ $# -ge 2 ]] || die "usage : veille start [--port N] [--host H]"; host="$2"; shift 2 ;;
      *) die "option inconnue : $1 (usage : veille start [--port N] [--host H])" ;;
    esac
  done
  [[ "$port" =~ ^[0-9]+$ ]] || die "port invalide : $port"
  if pid="$(server_pid)"; then
    echo "Serveur déjà démarré (PID $pid) : $(cat "$URL_FILE" 2>/dev/null)"
    return 0
  fi
  url="http://$host:$port"
  healthy "$url" && die "le port $port répond déjà (autre serveur ?) : choisir --port N"
  mkdir -p "$RUN_DIR"
  echo "--- $(date '+%F %T') démarrage $url" >> "$LOG_FILE"
  (cd "$ROOT" && exec nohup "$PYTHON" -m app.main web --host "$host" --port "$port" >> "$LOG_FILE" 2>&1 < /dev/null) &
  pid=$!
  echo "$pid" > "$PID_FILE"
  echo "$url" > "$URL_FILE"
  for ((i = 0; i < ${VEILLE_START_TIMEOUT:-30} * 2; i++)); do
    if healthy "$url"; then
      echo "Serveur démarré (PID $pid) : $url"
      echo "Arrêt : veille stop · journal : veille logs -f"
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f -- "$PID_FILE" "$URL_FILE"
      echo "Le serveur s'est arrêté au démarrage. Fin du journal ($LOG_FILE) :" >&2
      tail -n 20 "$LOG_FILE" >&2
      exit 1
    fi
    sleep 0.5
  done
  echo "Serveur lancé (PID $pid) mais $url ne répond pas encore : veille status / veille logs" >&2
}

stop_server() {
  local pid
  if ! pid="$(server_pid)"; then
    echo "Aucun serveur démarré par « veille start »."
    return 0
  fi
  kill "$pid"
  for ((i = 0; i < 20; i++)); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.5
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "Arrêt forcé du serveur (PID $pid)."
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f -- "$PID_FILE" "$URL_FILE"
  echo "Serveur arrêté (PID $pid)."
}

server_status() {
  local pid url
  if ! pid="$(server_pid)"; then
    echo "Serveur arrêté. Démarrer : veille start"
    return 3
  fi
  url="$(cat "$URL_FILE" 2>/dev/null)"
  if healthy "$url"; then
    echo "Serveur actif (PID $pid) : $url"
    curl -fsS --max-time 3 "$url/api/health" | python3 -c '
import json, sys
h = json.load(sys.stdin)
llm = h["model"] + (" disponible" if h["model_available"] else " ABSENT") if h["ollama"] else "LLM injoignable"
notion = "oui" if h["notion"] else "non"
print("  LLM : %s · Notion : %s · documents : %s" % (llm, notion, h["memory"]["documents"]))' 2>/dev/null || true
  else
    echo "Serveur lancé (PID $pid) mais $url ne répond pas : veille logs"
    return 1
  fi
}

# Sans option, redémarre sur l'hôte et le port précédents.
restart_server() {
  local previous
  if [[ $# -eq 0 ]] && previous="$(cat "$URL_FILE" 2>/dev/null)" && [[ "$previous" =~ ^http://(.+):([0-9]+)$ ]]; then
    set -- --host "${BASH_REMATCH[1]}" --port "${BASH_REMATCH[2]}"
  fi
  stop_server
  start_server "$@"
}

install_tui() {
  local bun="$ROOT/tui/node_modules/.bin/bun"
  if [[ ! -x "$bun" ]]; then
    command -v npm >/dev/null || die "npm introuvable : installer Node.js, puis relancer « veille tui »"
    echo "Installation de la TUI (npm install dans tui/, une seule fois)…"
    (cd "$ROOT/tui" && npm install --no-audit --no-fund) || die "échec de l'installation de la TUI"
  fi
}

run_tui() {
  install_tui
  cd "$ROOT/tui" && VEILLE_SCREEN="${1:-home}" exec "$ROOT/tui/node_modules/.bin/bun" run src/index.tsx
}

build_tui() {
  install_tui
  "$ROOT/tui/scripts/build.sh" "$@"
}

show_logs() {
  [[ -f "$LOG_FILE" ]] || { echo "Aucun journal ($LOG_FILE)."; return 0; }
  if [[ "${1:-}" == "-f" ]]; then
    tail -n 50 -f "$LOG_FILE"
  else
    tail -n 50 "$LOG_FILE"
  fi
}

cycle() {
  local id_file run_id answer note
  id_file="$(mktemp)"
  # chemin figé à la définition (la variable locale n'existe plus quand le trap s'exécute)
  # shellcheck disable=SC2064
  trap "rm -f -- '$id_file'; trap - RETURN" RETURN
  app run --run-id-file "$id_file" "$@"
  run_id="$(cat "$id_file")"
  [[ -n "$run_id" ]] || die "identifiant du run introuvable"

  # Publication directe (--approve), run bloqué ou en échec : rien à valider.
  if ! app pending | grep -q "^$run_id"; then
    echo "Run $run_id terminé sans validation en attente."
    return 0
  fi
  if [[ ! -t 0 && -z "${VEILLE_ASSUME_TTY:-}" ]]; then
    echo "Validation en attente. Publier : veille approve $run_id \"note\" · Rejeter : veille reject $run_id \"motif\""
    return 0
  fi
  echo
  read -r -p "Publier ce digest ? [o]ui / [r]ejeter / [p]lus tard : " answer
  case "${answer,,}" in
    o|oui|y|yes)
      read -r -p "Note (facultative, mémorisée pour les prochaines veilles) : " note
      app resume "$run_id" --approved --note "$note" ;;
    r|rejeter|n|non)
      read -r -p "Motif du rejet (devient une leçon) : " note
      app resume "$run_id" --rejected --note "$note" ;;
    *)
      echo "En attente. Plus tard : veille approve $run_id \"note\" ou veille reject $run_id \"motif\"" ;;
  esac
}

main() {
  local command="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$command" in
    help|-h|--help) usage; return 0 ;;
  esac
  require_python
  case "$command" in
    cycle)   cycle "$@" ;;
    run)     app run "$@" ;;
    resume)
      [[ $# -ge 2 ]] || die "usage : veille resume <run_id> --approved|--rejected [--note \"…\"]"
      app resume "$@" ;;
    approve)
      [[ $# -ge 1 ]] || die "usage : veille approve <run_id> [\"note\"]"
      app resume "$1" --approved --note "${2:-}" ;;
    reject)
      [[ $# -ge 2 && -n "$2" ]] || die "usage : veille reject <run_id> \"motif\" (le motif est obligatoire : il devient une leçon)"
      app resume "$1" --rejected --note "$2" ;;
    pending) app pending ;;
    show)
      [[ $# -ge 1 ]] || die "usage : veille show <run_id>"
      app show "$1" ;;
    grill)   app grill ;;
    review)
      [[ $# -ge 1 ]] || die "usage : veille review <url> [--json]"
      app review "$@" ;;
    knowledge) app knowledge "$@" ;;
    source)  app source "$@" ;;
    news|actus) app news "$@" ;;
    events)  app events "$@" ;;
    media)   app media "$@" ;;
    benchmarks|bench) app benchmarks "$@" ;;
    cron)    app cron "$@" ;;
    web)     app web "$@" ;;
    web-password) app web-password "$@" ;;
    start)   start_server "$@" ;;
    stop)    stop_server ;;
    restart) restart_server "$@" ;;
    status)  server_status ;;
    tui)     run_tui "$@" ;;
    tui-build) build_tui "$@" ;;
    logs)    show_logs "$@" ;;
    doctor)  app doctor ;;
    report)  app report "$@" ;;
    notion)  app notion-sync ;;
    memory)  app memory "$@" ;;
    why)     app why "$@" ;;
    rules)   app rules "$@" ;;
    test)    cd "$ROOT" && "$PYTHON" -m pytest -q "$@" ;;
    *)       usage >&2; die "commande inconnue : $command" ;;
  esac
}

main "$@"
