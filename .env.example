# Fournisseur : ollama (défaut) | openai (serveur compatible OpenAI) | anthropic (API Claude native)
# Voir docs/llm-ollama-claude.md
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
# Ollama : API native (un suffixe /v1 est toléré) ; openai : URL du serveur compatible
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=ollama
LLM_MODEL=gemma-3-4b-it
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_TIMEOUT=180

# Budgets du harness par run
MAX_LLM_CALLS=20
MAX_DOCUMENTS_PER_RUN=24
SCOUT_BATCH_SIZE=8
MAX_SIGNALS=8
MAX_AGE_DAYS=14

# Supervisor : patterns conditionnels
MIN_RELEVANCE=6
MIN_ACCEPTED=3
MAX_REVIEW_ROUNDS=1
MAX_REPAIR_ROUNDS=1

# Sources (voir sources.toml)
GITHUB_TOKEN=
ARXIV_MAX_RESULTS=20
RSS_MAX_ITEMS=8

# Stockage et mémoire
DATABASE_PATH=data/watch.db
CHECKPOINT_DB_PATH=data/checkpoints.db
MEMORY_DB_PATH=data/memory.db
OUTPUT_DIR=output

# false = publication directe ; true = arrêt avant publication
HUMAN_APPROVAL=true

# Rapports datés
REPORTS_DIR=reports
PROMPT_OVERRIDES_DIR=data/prompts

# Notion (serveur MCP notion-veille) — voir docs/getting-started.html
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DIGESTS=10

# Interface web (python -m app.main web)
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Base de connaissances : fichiers Markdown téléversés (knowledge/ reste en lecture seule)
KNOWLEDGE_UPLOADS_DIR=data/knowledge

# Review d'une actualité par URL
REVIEW_MAX_CHARS=12000
REVIEW_TIMEOUT=20
# true = autoriser les URL du réseau local (déconseillé : protection SSRF)
REVIEW_ALLOW_PRIVATE=false

# Observabilité facultative — Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Facultatif : identifiant du projet (Settings du projet) pour construire les liens sans appel API
LANGFUSE_PROJECT_ID=

# Observabilité facultative — LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-watch-harness
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
