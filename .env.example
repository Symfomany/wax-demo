# Fournisseur : ollama (défaut) | openai (serveur compatible OpenAI) | anthropic (API Claude native)
# Voir docs/llm-ollama-claude.md
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
# Ollama : API native (un suffixe /v1 est toléré) ; openai : URL du serveur compatible
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=ollama
LLM_MODEL=gemma-3-4b-it
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_TIMEOUT=180

# Budgets du harness par run
MAX_LLM_CALLS=20
MAX_DOCUMENTS_PER_RUN=24
SCOUT_BATCH_SIZE=8
MAX_SIGNALS=8
MAX_AGE_DAYS=14

# Supervisor : patterns conditionnels
MIN_RELEVANCE=6
MIN_ACCEPTED=3
MAX_REVIEW_ROUNDS=1
MAX_REPAIR_ROUNDS=1

# Qualité : bruit et quasi-doublons écartés avant le Scout, puis ranking hybride explicable
# Seuil de similarité des titres (Jaccard, 0.3-1) au-delà duquel deux items sont des doublons
DEDUP_THRESHOLD=0.7
# Pool du prefilter = MAX_DOCUMENTS_PER_RUN × facteur (réduire à 2 sur la Jetson si besoin)
QUALITY_POOL_FACTOR=3
# Poids du ranking (JSON, clés : llm, freshness, profile, source, corroboration) ; vide = défauts
# RANK_WEIGHTS={"llm": 0.5, "freshness": 0.15, "profile": 0.15, "source": 0.1, "corroboration": 0.1}

# Sources (voir sources.toml)
GITHUB_TOKEN=
ARXIV_MAX_RESULTS=20
RSS_MAX_ITEMS=8

# Stockage et mémoire
DATABASE_PATH=data/watch.db
CHECKPOINT_DB_PATH=data/checkpoints.db
MEMORY_DB_PATH=data/memory.db
OUTPUT_DIR=output

# false = publication directe ; true = arrêt avant publication
HUMAN_APPROVAL=true

# Rapports datés
REPORTS_DIR=reports
PROMPT_OVERRIDES_DIR=data/prompts

# Notion (serveur MCP notion-veille) — voir docs/getting-started.html
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DIGESTS=10

# Interface web (python -m app.main web)
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Jeton de l'API web (vide : aucune authentification, réservé à un accès local).
# Navigateur : ouvrir une fois /?token=<jeton> (cookie) ; scripts : en-tête Authorization: Bearer <jeton>
WEB_API_TOKEN=
# Verrouillage par login (page /login, recommandé) : mot de passe d'au moins 8 caractères avec minuscule,
# majuscule, chiffre et caractère spécial — sinon le serveur refuse de démarrer.
# Générer et ajouter : python -m app.main web-password --write-env   (ou bin/veille web-password --write-env)
# La TUI et les scripts utilisent les mêmes identifiants (HTTP Basic).
WEB_USERNAME=
WEB_PASSWORD=
WEB_PASSWORD_MIN_LENGTH=8
WEB_SESSION_HOURS=12
# Clé de signature des sessions (vide : aléatoire, reconnexion après chaque redémarrage)
WEB_SESSION_SECRET=
# Anti-force brute : échecs tolérés par adresse, puis blocage (secondes)
WEB_LOGIN_MAX_FAILURES=5
WEB_LOGIN_LOCK_SECONDS=300

# Base de connaissances : fichiers Markdown téléversés (knowledge/ reste en lecture seule)
KNOWLEDGE_UPLOADS_DIR=data/knowledge

# Review d'une actualité par URL
REVIEW_MAX_CHARS=12000
REVIEW_TIMEOUT=20
# true = autoriser les URL du réseau local (déconseillé : protection SSRF)
REVIEW_ALLOW_PRIVATE=false

# Actus en cartes (onglet 🗞️ Actus) : recherche web par l'API Claude (outil serveur web_search)
# Clé API Claude dédiée (sinon ANTHROPIC_API_KEY)
CLAUDE_API=
# Seulement si la clé n'est rattachée à aucun workspace (erreur « anthropic-workspace-id ») :
# identifiant du workspace (Console Claude → Settings → Workspaces)
CLAUDE_WORKSPACE_ID=
NEWS_MODEL=claude-sonnet-5
# Assistant rapide (panneau flottant de l'interface web), même clé
ASSISTANT_MODEL=claude-sonnet-5
NEWS_SEARCH_TOOL=web_search_20250305
NEWS_SEARCH_MAX_USES=5
NEWS_SEARCH_DAYS=7
NEWS_PER_SOURCE=24
# Aperçus des actus sans image : captures d'écran par le serveur MCP Playwright (@playwright/mcp@0.0.82).
# Prérequis : Node.js + navigateur (npx -y playwright@1.64.0-alpha-1789764292000 install chromium)
SCREENSHOT_ENABLED=false
SCREENSHOT_MAX_PER_RUN=6
SCREENSHOT_TIMEOUT=45
SCREENSHOT_SETTLE_SECONDS=3
SCREENSHOT_DIR=data/screenshots
# Événements IA (onglet 📅) : horizon en jours, pages d'événements lues en parallèle (vérification des dates)
EVENTS_HORIZON_DAYS=120
EVENTS_FETCH_WORKERS=3
# Benchmarks (onglet 📊) : BenchLM.ai (catalogue + détail à la demande, mis en cache N heures)
BENCHMARKS_URL=https://benchlm.ai
BENCHMARKS_DETAIL_TTL_HOURS=24
# Vidéos & podcasts (onglet 🎬) : fenêtre de la recherche Claude, entrées par flux [[media]] de sources.toml
MEDIA_SEARCH_DAYS=14
MEDIA_PER_SOURCE=12

# Observabilité facultative — Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Facultatif : identifiant du projet (Settings du projet) pour construire les liens sans appel API
LANGFUSE_PROJECT_ID=

# Observabilité facultative — LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-watch-harness
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
