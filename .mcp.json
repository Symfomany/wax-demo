{
  "mcpServers": {
    "github-scout": {
      "command": "/home/boyer/wax-demo/.venv/bin/python",
      "args": ["/home/boyer/wax-demo/app/mcp_servers/github_server.py"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN:-}"
      }
    },
    "notion-veille": {
      "command": "/home/boyer/wax-demo/.venv/bin/python",
      "args": ["/home/boyer/wax-demo/app/mcp_servers/notion_server.py"],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN:-}"
      }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN:-}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82", "--headless", "--isolated", "--browser", "chromium", "--block-service-workers", "--output-dir", "data/playwright-mcp"]
    }
  }
}
